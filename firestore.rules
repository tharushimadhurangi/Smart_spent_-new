rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTransactionData() {
      let data = request.resource.data;
      return data.amount is number
          && data.amount > 0
          && data.category is string
          && data.description is string
          && data.date is timestamp
          && data.userId is string;
    }

    // 1. User Root Document & Subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Income Subcollection: users/{userId}/income/{incomeId}
      match /income/{incomeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransactionData();
        allow update: if isOwner(userId) && isValidTransactionData();
        allow delete: if isOwner(userId);
      }

      // Expense Subcollection: users/{userId}/expense/{expenseId}
      match /expense/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransactionData();
        allow update: if isOwner(userId) && isValidTransactionData();
        allow delete: if isOwner(userId);
      }
    }

    // 2. Root Income Collection: /income/{incomeId}
    match /income/{incomeId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidTransactionData();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidTransactionData();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. Root Expense Collection: /expense/{expenseId}
    match /expense/{expenseId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidTransactionData();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidTransactionData();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
